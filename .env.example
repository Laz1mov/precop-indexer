# ==============================================================================
# Precop Consensus Indexer — Configuration
# ==============================================================================

# Bitcoin Core Node RPC Configuration
# Mandatory: Bitcoin Core must have txindex=1 enabled in bitcoin.conf
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=your_rpc_username
BITCOIN_RPC_PASS=your_rpc_password

# Indexer REST API Port (default: 8080)
TUSM_API_PORT=8080

# UniSat Sidecar Configuration
# NOTE: NO API KEY IS REQUIRED! The sidecar operates autonomously using public wallet-api endpoints.
UNISAT_API_KEY=
SIDECAR_PORT=8085
POLL_INTERVAL_SECS=15

# Protocol Treasury Address (default is canonical LEAF & CRC treasury)
TREASURY_ADDRESS=bc1p8q4hnqrve9tdd7yzx650m4ct007w38p8gkcylrmffherq25987fq4e6ajr
